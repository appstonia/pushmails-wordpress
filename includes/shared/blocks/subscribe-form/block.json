{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "pushmails/subscribe-form",
  "title": "PushMails subscribe form",
  "category": "widgets",
  "icon": "email-alt",
  "description": "A subscribe form with double opt-in. Visitors join your PushMails audience after confirming their address.",
  "keywords": ["newsletter", "subscribe", "email", "pushmails"],
  "textdomain": "pushmails-for-wordpress",
  "attributes": {
    "showName": { "type": "boolean", "default": false },
    "buttonText": { "type": "string", "default": "" }
  },
  "supports": { "html": false, "align": ["wide", "full"] },
  "editorScript": "file:./editor.js"
}
